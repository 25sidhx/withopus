# Copy this to .env and fill in your values

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here

# NVIDIA NIM proxy (your local or Azure VM server)
NIM_BASE_URL=http://localhost:8082
NVIDIA_API_KEY=not-needed

# Auto-generate interval (hours)
DIGEST_INTERVAL_HOURS=6
